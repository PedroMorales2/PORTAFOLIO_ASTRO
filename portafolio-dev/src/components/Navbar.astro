---
import { PROFILE, NAV_LINKS } from "@/data/profile";
import { Menu, X, Github } from "lucide-react";
---

<header
  data-navbar
  class="fixed inset-x-0 top-0 z-[100] transition-all duration-500"
>
  <nav class="container-x flex h-[72px] items-center justify-between" aria-label="Navegación principal">
    <a
      href="#inicio"
      class="font-display text-lg font-bold tracking-tight text-ink"
      data-magnetic
      data-magnetic-strength="0.2"
      aria-label="Ir al inicio"
    >
      pm<span class="text-gradient">.</span>
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link text-[0.88rem] font-medium text-muted transition-colors duration-300 hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={PROFILE.links.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub de Pedro Morales"
        class="flex size-9 items-center justify-center rounded-full border border-line text-muted transition-colors duration-300 hover:border-accent/50 hover:text-ink"
        data-magnetic
      >
        <Github size={16} aria-hidden="true" />
      </a>
      <a
        href={`mailto:${PROFILE.email}`}
        class="rounded-full bg-ink px-4 py-2 text-[0.85rem] font-semibold text-void transition-transform duration-300 hover:scale-[1.04]"
        data-magnetic
        data-magnetic-strength="0.25"
      >
        Hablemos
      </a>
    </div>

    <button
      type="button"
      class="flex size-10 items-center justify-center rounded-full border border-line text-ink lg:hidden"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
    >
      <span class="menu-icon-open"><Menu size={20} aria-hidden="true" /></span>
      <span class="menu-icon-close hidden"><X size={20} aria-hidden="true" /></span>
    </button>
  </nav>

  <!-- Menú móvil -->
  <div
    id="menu-movil"
    data-mobile-menu
    data-open="false"
    class="mobile-menu fixed inset-0 z-[-1] flex flex-col justify-center bg-void/95 backdrop-blur-2xl lg:hidden"
  >
    <ul class="container-x flex flex-col gap-2">
      {
        NAV_LINKS.map((link, i) => (
          <li>
            <a
              href={link.href}
              class="font-display block py-3 text-4xl font-bold tracking-tight text-ink/90 transition-colors hover:text-accent"
              style={`transition-delay: ${i * 40}ms`}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="container-x mt-10 flex gap-4">
      <a href={PROFILE.links.github} target="_blank" rel="noopener noreferrer" class="chip">GitHub</a>
      <a href={PROFILE.links.linkedin} target="_blank" rel="noopener noreferrer" class="chip">LinkedIn</a>
      <a href={`mailto:${PROFILE.email}`} class="chip">Email</a>
    </div>
  </div>
</header>

<style>
  header.nav-scrolled nav {
    height: 60px;
  }
  header.nav-scrolled {
    background: rgb(5 6 11 / 0.65);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid var(--color-line-soft);
  }
  .nav-link[data-active="true"] {
    color: var(--color-ink);
  }
  .mobile-menu {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out-expo);
  }
  .mobile-menu[data-open="true"] {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu[data-open="true"] ~ * .menu-icon-open {
    display: none;
  }
  header:has(.mobile-menu[data-open="true"]) .menu-icon-open {
    display: none;
  }
  header:has(.mobile-menu[data-open="true"]) .menu-icon-close {
    display: flex;
  }
</style>

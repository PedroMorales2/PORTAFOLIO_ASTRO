---
import { PROFILE } from "@/data/profile";
import HeroScene from "@/components/three/HeroScene";
import { Github, Linkedin, FileDown, ArrowRight } from "lucide-react";
---

<section id="inicio" class="relative flex min-h-svh items-center overflow-hidden">
  <!-- Capa de fondo: grilla + resplandores (también actúan como fallback del 3D) -->
  <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div
      class="absolute -top-40 left-1/2 h-[520px] w-[820px] -translate-x-1/3 rounded-full bg-accent-deep/20 blur-[140px]"
    >
    </div>
    <div
      class="absolute bottom-0 right-[-10%] h-[420px] w-[520px] rounded-full bg-cyan/10 blur-[130px]"
    >
    </div>
  </div>

  <!-- Experiencia 3D (isla React, solo cliente, con fallback silencioso) -->
  <div class="absolute inset-0 opacity-60 md:opacity-100 lg:left-[14%]">
    <HeroScene client:only="react" />
  </div>

  <!-- Degradado inferior para fundir con la siguiente sección -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-void"
    aria-hidden="true"
  >
  </div>

  <div class="container-x relative z-10 pb-24 pt-32">
    <p
      data-hero-fade
      class="glass inline-flex items-center gap-2.5 rounded-full px-4 py-2 text-[0.82rem] font-medium text-muted"
    >
      <span class="dot-pulse inline-block size-2 rounded-full bg-teal" aria-hidden="true"></span>
      {PROFILE.availability}
    </p>

    <h1
      class="font-display mt-8 max-w-4xl text-[clamp(2.9rem,9vw,6.8rem)] font-bold leading-[1.02] tracking-[-0.03em]"
    >
      <span class="block" data-split>Construyo software</span>
      <span class="text-gradient block" data-split>inteligente.</span>
    </h1>

    <p data-hero-fade class="mt-7 max-w-xl text-lg leading-relaxed text-muted md:text-xl text-pretty">
      Soy <strong class="font-semibold text-ink">{PROFILE.name}</strong>, {PROFILE.role.toLowerCase()} de
      Perú. Diseño y desarrollo productos de extremo a extremo: <span class="text-ink">full stack</span>,
      <span class="text-ink">inteligencia artificial</span>, <span class="text-ink">backend</span> y
      <span class="text-ink">móvil</span>.
    </p>

    <div data-hero-fade class="mt-11 flex flex-wrap items-center gap-4">
      <a
        href="#proyectos"
        class="group inline-flex items-center gap-2.5 rounded-full bg-ink px-7 py-3.5 text-[0.95rem] font-semibold text-void transition-transform duration-300 hover:scale-[1.03]"
        data-magnetic
        data-magnetic-strength="0.25"
      >
        Ver proyectos
        <ArrowRight
          size={17}
          aria-hidden="true"
          className="transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
      <a
        href={PROFILE.links.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="glass inline-flex items-center gap-2.5 rounded-full px-7 py-3.5 text-[0.95rem] font-semibold text-ink transition-colors duration-300 hover:border-accent/40"
        data-magnetic
        data-magnetic-strength="0.25"
      >
        <FileDown size={17} aria-hidden="true" />
        Descargar CV
      </a>

      <span class="mx-1 hidden h-6 w-px bg-line sm:block" aria-hidden="true"></span>

      <div class="flex items-center gap-2.5">
        <a
          href={PROFILE.links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub de Pedro Morales"
          class="flex size-11 items-center justify-center rounded-full border border-line text-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:text-ink"
          data-magnetic
        >
          <Github size={18} aria-hidden="true" />
        </a>
        <a
          href={PROFILE.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Pedro Morales"
          class="flex size-11 items-center justify-center rounded-full border border-line text-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:text-ink"
          data-magnetic
        >
          <Linkedin size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <a
    href="#sobre-mi"
    data-hero-fade
    class="absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-3 text-faint transition-colors hover:text-muted md:flex"
    aria-label="Bajar a la sección Sobre mí"
  >
    <span class="font-mono text-[0.65rem] uppercase tracking-[0.25em]">Desliza</span>
    <span class="flex h-9 w-5 items-start justify-center rounded-full border border-line p-1.5">
      <span class="scroll-hint-dot block h-1.5 w-1 rounded-full bg-accent" aria-hidden="true"></span>
    </span>
  </a>
</section>

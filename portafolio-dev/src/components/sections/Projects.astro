---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { PROJECTS, MORE_PROJECTS } from "@/data/projects";
import { Github, ExternalLink, CircleDashed, FolderGit2 } from "lucide-react";

const DETAIL_LABELS = [
  { key: "problem", label: "Problema" },
  { key: "solution", label: "Solución" },
  { key: "architecture", label: "Arquitectura" },
  { key: "challenges", label: "Retos" },
  { key: "results", label: "Resultados" },
] as const;
---

<section id="proyectos" class="relative py-28 md:py-36">
  <div class="container-x">
    <SectionHeading
      eyebrow="Proyectos destacados"
      title="Case studies, no capturas sueltas."
      description="Cada proyecto contado como lo que es: un problema real, una solución de ingeniería y las decisiones de arquitectura detrás."
    />
  </div>

  <div class="mt-10">
    {
      PROJECTS.map((project, i) => (
        <article
          class="group/project relative border-t border-line-soft py-20 last:border-b md:py-28"
          aria-labelledby={`proyecto-${project.slug}`}
        >
          <span
            class="font-display pointer-events-none absolute right-4 top-8 select-none text-[7rem] font-bold leading-none text-ink/[0.04] md:text-[11rem]"
            aria-hidden="true"
          >
            {project.index}
          </span>

          <div
            class:list={[
              "container-x grid items-start gap-12 lg:gap-16",
              i % 2 === 0
                ? "lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)]"
                : "lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)]",
            ]}
          >
            {/* Portada */}
            <div
              class:list={["relative", i % 2 === 1 && "lg:order-2"]}
              data-reveal={i % 2 === 0 ? "left" : "right"}
            >
              <div
                class="absolute -inset-6 rounded-[2.5rem] opacity-25 blur-3xl transition-opacity duration-700 group-hover/project:opacity-40"
                style={`background: radial-gradient(ellipse at center, ${project.accent}55, transparent 70%)`}
                aria-hidden="true"
              />
              <div class="card-line relative overflow-hidden rounded-3xl p-2">
                <div class="overflow-hidden rounded-2xl">
                  <img
                    src={project.cover}
                    alt={project.coverAlt}
                    width="1200"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    data-parallax
                    class="aspect-[3/2] w-full scale-[1.12] object-cover transition-transform duration-700 will-change-transform"
                  />
                </div>
              </div>

              <div class="mt-6 flex flex-wrap items-center gap-3">
                {project.github ? (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="glass inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-accent/40"
                    data-magnetic
                  >
                    <Github size={15} aria-hidden="true" /> Código
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-2 rounded-full border border-dashed border-line px-5 py-2.5 text-sm text-faint">
                    <CircleDashed size={14} aria-hidden="true" /> Repo: TODO
                  </span>
                )}
                {project.live ? (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-void transition-transform duration-300 hover:scale-[1.04]"
                    data-magnetic
                  >
                    <ExternalLink size={15} aria-hidden="true" /> Ver en vivo
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-2 rounded-full border border-dashed border-line px-5 py-2.5 text-sm text-faint">
                    <CircleDashed size={14} aria-hidden="true" /> Demo: TODO
                  </span>
                )}
              </div>
            </div>

            {/* Contenido del case study */}
            <div class:list={[i % 2 === 1 && "lg:order-1"]}>
              <p class="eyebrow" data-reveal>
                <span class="inline-block h-px w-8 bg-accent/60" aria-hidden="true" />
                {project.category}
              </p>
              <h3
                id={`proyecto-${project.slug}`}
                class="font-display mt-4 text-3xl font-bold tracking-tight text-balance md:text-4xl"
                data-reveal
              >
                {project.title}
              </h3>
              <p class="mt-4 text-lg leading-relaxed text-muted text-pretty" data-reveal>
                {project.tagline}
              </p>

              <dl class="mt-8 space-y-5" data-stagger>
                {DETAIL_LABELS.map(({ key, label }) => (
                  <div class="border-l-2 border-line pl-5" data-stagger-item>
                    <dt class="font-mono text-[0.65rem] uppercase tracking-[0.22em] text-accent">
                      {label}
                    </dt>
                    <dd class="mt-1.5 leading-relaxed text-muted text-pretty">{project[key]}</dd>
                  </div>
                ))}
              </dl>

              <ul class="mt-8 flex flex-wrap gap-2" role="list" data-reveal>
                {project.stack.map((tech) => (
                  <li class="chip !py-1.5 !text-[0.74rem]">{tech}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Más proyectos -->
  <div class="container-x mt-24">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">
        <span class="inline-block h-px w-8 bg-accent/60" aria-hidden="true"></span>
        Más proyectos
      </p>
      <h3 class="font-display mt-4 text-3xl font-bold tracking-tight md:text-4xl">
        El resto del taller.
      </h3>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        MORE_PROJECTS.map((mini) => (
          <article class="card-line group flex flex-col gap-3 p-6" data-stagger-item>
            <header class="flex items-start justify-between gap-3">
              <h4 class="font-display text-[1.02rem] font-bold leading-snug tracking-tight text-balance">
                {mini.title}
              </h4>
              {mini.github ? (
                <a
                  href={mini.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Repositorio de ${mini.title}`}
                  class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent/50 hover:text-ink"
                >
                  <Github size={14} aria-hidden="true" />
                </a>
              ) : (
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line-soft text-faint">
                  <FolderGit2 size={14} aria-hidden="true" />
                </span>
              )}
            </header>
            <p class="text-[0.88rem] leading-relaxed text-muted text-pretty">{mini.description}</p>
            <ul class="mt-auto flex flex-wrap gap-1.5 pt-2" role="list">
              {mini.stack.map((tech) => (
                <li class="chip !px-2.5 !py-1 !text-[0.68rem]">{tech}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

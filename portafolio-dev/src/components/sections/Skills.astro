---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { SKILL_DOMAINS } from "@/data/skills";
import {
  Monitor,
  Server,
  Smartphone,
  Brain,
  Map,
  Workflow,
  Database,
  Award,
  Layers,
} from "lucide-react";

const ICONS: Record<string, typeof Monitor> = {
  monitor: Monitor,
  server: Server,
  smartphone: Smartphone,
  brain: Brain,
  map: Map,
  workflow: Workflow,
  database: Database,
  award: Award,
  layers: Layers,
};
---

<section id="stack" class="relative py-28 md:py-36">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-[400px] w-[700px] -translate-x-1/2 rounded-full bg-accent-deep/10 blur-[160px]"
    aria-hidden="true"
  >
  </div>

  <div class="container-x relative">
    <SectionHeading
      eyebrow="Stack técnico"
      title="Herramientas con propósito."
      description="Tecnologías organizadas por dominio, elegidas y aprendidas resolviendo proyectos reales — no coleccionando logos."
    />

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {
        SKILL_DOMAINS.map((domain) => {
          const Icon = ICONS[domain.icon] ?? Layers;
          return (
            <article class="card-line flex flex-col gap-5 p-6" data-stagger-item>
              <header class="flex items-center gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-line bg-panel text-accent">
                  <Icon size={18} aria-hidden="true" />
                </span>
                <h3 class="font-display text-[1.05rem] font-bold tracking-tight">{domain.domain}</h3>
              </header>
              <ul class="flex flex-wrap gap-2" role="list">
                {domain.skills.map((skill) => (
                  <li class="chip !px-3 !py-1.5 !text-[0.74rem]">{skill}</li>
                ))}
              </ul>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

---
import { PROFILE, NAV_LINKS } from "@/data/profile";
import { Github, Linkedin, Mail, ArrowUp } from "lucide-react";

const year = new Date().getFullYear();
---

<footer class="relative border-t border-line-soft">
  <div class="container-x flex flex-col gap-10 py-14 md:flex-row md:items-end md:justify-between">
    <div class="max-w-sm">
      <a href="#inicio" class="font-display text-2xl font-bold tracking-tight">
        pm<span class="text-gradient">.</span>
      </a>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        {PROFILE.role} — {PROFILE.location}. Construyendo software con criterio,
        desde el backend hasta el último pixel.
      </p>
    </div>

    <nav aria-label="Enlaces del pie de página" class="flex flex-wrap gap-x-6 gap-y-2">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="link-underline text-sm text-muted transition-colors hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={PROFILE.links.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="flex size-10 items-center justify-center rounded-full border border-line text-muted transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:text-ink"
        data-magnetic
      >
        <Github size={17} aria-hidden="true" />
      </a>
      <a
        href={PROFILE.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="flex size-10 items-center justify-center rounded-full border border-line text-muted transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:text-ink"
        data-magnetic
      >
        <Linkedin size={17} aria-hidden="true" />
      </a>
      <a
        href={`mailto:${PROFILE.email}`}
        aria-label="Enviar correo"
        class="flex size-10 items-center justify-center rounded-full border border-line text-muted transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:text-ink"
        data-magnetic
      >
        <Mail size={17} aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="border-t border-line-soft">
    <div class="container-x flex items-center justify-between py-5 text-xs text-faint">
      <p>© {year} {PROFILE.fullName}. Hecho en Perú 🇵🇪</p>
      <a
        href="#inicio"
        class="inline-flex items-center gap-1.5 transition-colors hover:text-ink"
        aria-label="Volver arriba"
      >
        Volver arriba <ArrowUp size={13} aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>
